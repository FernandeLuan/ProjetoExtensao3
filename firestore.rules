rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(barbeariaId, uid) {
      return /databases/$(database)/documents/barbearias/$(barbeariaId)/membros/$(uid);
    }

    function memberExists(barbeariaId, uid) {
      return signedIn() && exists(memberPath(barbeariaId, uid));
    }

    function memberData(barbeariaId, uid) {
      return get(memberPath(barbeariaId, uid)).data;
    }

    function isActiveMember(barbeariaId) {
      return memberExists(barbeariaId, request.auth.uid)
        && memberData(barbeariaId, request.auth.uid).ativo == true;
    }

    function isAdmin(barbeariaId) {
      return isActiveMember(barbeariaId)
        && (
          memberData(barbeariaId, request.auth.uid).papel == "admin"
          || memberData(barbeariaId, request.auth.uid).papel == "owner"
        );
    }

    function canActAsProfessional(barbeariaId) {
      return isActiveMember(barbeariaId)
        && memberData(barbeariaId, request.auth.uid).get("atuaComoProfissional", true) != false;
    }

    function targetCanActAsProfessional(barbeariaId, uid) {
      return memberExists(barbeariaId, uid)
        && memberData(barbeariaId, uid).ativo == true
        && memberData(barbeariaId, uid).get("atuaComoProfissional", true) != false;
    }

    function isTechnicalOwner(barbeariaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/barbearias/$(barbeariaId))
        && get(/databases/$(database)/documents/barbearias/$(barbeariaId)).data.ownerUid == request.auth.uid;
    }

    function validCardRate(value) {
      return value is number && value >= 0 && value < 10;
    }

    function validRepasse(value) {
      return value is number && value >= 0 && value <= 99.99;
    }

    // =========================================================
    // USUÁRIOS
    // Compatível com os documentos atuais. O usuário altera só o
    // próprio perfil; admin pode criar o perfil de um novo barbeiro.
    // =========================================================
    match /usuarios/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn() && (
        request.auth.uid == uid
        || (
          request.resource.data.barbeariaId is string
          && isAdmin(request.resource.data.barbeariaId)
        )
      );

      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // =========================================================
    // BARBEARIAS
    // =========================================================
    match /barbearias/{barbeariaId} {
      allow read: if isActiveMember(barbeariaId) || isTechnicalOwner(barbeariaId);

      allow create: if signedIn()
        && barbeariaId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;

      // Mantém compatibilidade, mas impede troca do ownerUid pelo cliente.
      allow update: if isAdmin(barbeariaId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      // -------------------------------------------------------
      // MEMBROS / EQUIPE
      // -------------------------------------------------------
      match /membros/{uid} {
        allow read: if signedIn() && (
          uid == request.auth.uid
          || isAdmin(barbeariaId)
        );

        allow create: if signedIn() && (
          (
            barbeariaId == request.auth.uid
            && uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && (
              request.resource.data.papel == "admin"
              || request.resource.data.papel == "owner"
            )
          )
          || (
            isAdmin(barbeariaId)
            && request.resource.data.uid == uid
            && request.resource.data.papel == "barber"
            && request.resource.data.ativo == true
            && request.resource.data.get("dono", false) == false
            && request.resource.data.get("atuaComoProfissional", true) != false
          )
        );

        // Admin: financeiro de qualquer membro e ativar/desativar barbeiro.
        // Profissional: próprio nome, taxas e conclusão do primeiro acesso.
        allow update: if (
          isAdmin(barbeariaId)
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "repassePct",
                "taxaDebitoPct",
                "taxaCreditoPct",
                "precosPersonalizados",
                "atualizadoEm"
              ])
              && validRepasse(request.resource.data.get("repassePct", 0))
              && validCardRate(request.resource.data.get("taxaDebitoPct", 0))
              && validCardRate(request.resource.data.get("taxaCreditoPct", 0))
              && request.resource.data.get("precosPersonalizados", {}) is map
              && (
                resource.data.get("dono", false) != true
                || request.resource.data.get("repassePct", 0) == 0
              )
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "ativo",
                "atualizadoEm"
              ])
              && uid != request.auth.uid
              && resource.data.papel == "barber"
              && resource.data.get("removido", false) != true
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "ativo",
                "removido",
                "atualizadoEm"
              ])
              && uid != request.auth.uid
              && resource.data.papel == "barber"
              && resource.data.ativo == false
              && request.resource.data.ativo == false
              && request.resource.data.removido == true
            )
          )
        ) || (
          signedIn()
          && uid == request.auth.uid
          && resource.data.ativo == true
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "nome",
              "atualizadoEm"
            ])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "taxaDebitoPct",
                "taxaCreditoPct",
                "atualizadoEm"
              ])
              && validCardRate(request.resource.data.get("taxaDebitoPct", 0))
              && validCardRate(request.resource.data.get("taxaCreditoPct", 0))
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "primeiroAcessoPendente",
                "atualizadoEm"
              ])
              && request.resource.data.primeiroAcessoPendente == false
            )
          )
        );

        allow delete: if false;
      }

      // -------------------------------------------------------
      // ATENDIMENTOS
      // -------------------------------------------------------
      match /atendimentos/{atendimentoId} {
        allow read: if isAdmin(barbeariaId) || (
          canActAsProfessional(barbeariaId)
          && resource.data.profissionalUid == request.auth.uid
        );

        allow create: if targetCanActAsProfessional(
            barbeariaId,
            request.resource.data.profissionalUid
          )
          && request.resource.data.registradoPorUid == request.auth.uid
          && (
            isAdmin(barbeariaId)
            || (
              canActAsProfessional(barbeariaId)
              && request.resource.data.profissionalUid == request.auth.uid
            )
          );

        allow update: if (
          isAdmin(barbeariaId)
          || (
            canActAsProfessional(barbeariaId)
            && resource.data.profissionalUid == request.auth.uid
          )
        )
        && request.resource.data.profissionalUid == resource.data.profissionalUid
        && request.resource.data.registradoPorUid == resource.data.registradoPorUid;

        allow delete: if isAdmin(barbeariaId) || (
          canActAsProfessional(barbeariaId)
          && resource.data.profissionalUid == request.auth.uid
        );
      }

      // -------------------------------------------------------
      // CONFIGURAÇÕES / CATÁLOGO GLOBAL
      // -------------------------------------------------------
      match /configuracoes/{configId} {
        allow read: if configId == "geral" && isActiveMember(barbeariaId);
        allow create, update: if configId == "geral" && isAdmin(barbeariaId);
        allow delete: if false;
      }

      // -------------------------------------------------------
      // DESPESAS
      // -------------------------------------------------------
      match /despesas/{despesaId} {
        allow read: if isAdmin(barbeariaId) || (
          canActAsProfessional(barbeariaId)
          && resource.data.tipo == "profissional"
          && resource.data.profissionalUid == request.auth.uid
        );

        allow create: if isActiveMember(barbeariaId)
          && request.resource.data.registradoPorUid == request.auth.uid
          && (
            (
              canActAsProfessional(barbeariaId)
              && request.resource.data.tipo == "profissional"
              && request.resource.data.profissionalUid == request.auth.uid
            )
            || (
              isAdmin(barbeariaId)
              && request.resource.data.tipo == "barbearia"
              && request.resource.data.get("profissionalUid", null) == null
            )
          );

        allow update: if (
          isAdmin(barbeariaId)
          || (
            canActAsProfessional(barbeariaId)
            && resource.data.tipo == "profissional"
            && resource.data.profissionalUid == request.auth.uid
          )
        )
        && request.resource.data.registradoPorUid == resource.data.registradoPorUid
        && (
          (
            resource.data.tipo == "profissional"
            && request.resource.data.tipo == "profissional"
            && request.resource.data.profissionalUid == resource.data.profissionalUid
          )
          || (
            isAdmin(barbeariaId)
            && resource.data.tipo == "barbearia"
            && request.resource.data.tipo == "barbearia"
            && request.resource.data.get("profissionalUid", null) == null
          )
        );

        allow delete: if isAdmin(barbeariaId) || (
          canActAsProfessional(barbeariaId)
          && resource.data.tipo == "profissional"
          && resource.data.profissionalUid == request.auth.uid
        );
      }

      // -------------------------------------------------------
      // RESUMOS DERIVADOS
      // -------------------------------------------------------
      match /resumosProfissionais/{uid}/dias/{diaId} {
        allow read: if isAdmin(barbeariaId) || (
          canActAsProfessional(barbeariaId)
          && uid == request.auth.uid
        );

        allow create, update: if isAdmin(barbeariaId) || (
          canActAsProfessional(barbeariaId)
          && uid == request.auth.uid
          && request.resource.data.profissionalUid == request.auth.uid
        );

        allow delete: if false;
      }

      match /resumosBarbearia/{diaId} {
        allow read, create, update: if isAdmin(barbeariaId);
        allow delete: if false;
      }
    }

    // Estrutura antiga permanece bloqueada.
    match /atendimentos/{documento} {
      allow read, write: if false;
    }

    match /configuracoes/{documento} {
      allow read, write: if false;
    }
  }
}
